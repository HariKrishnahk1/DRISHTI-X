# DRISHTI-X Defence AI Vision Integrity & Assurance Platform
# Environment Configuration

PROJECT_NAME=DRISHTI-X
VERSION=1.0.0
ENVIRONMENT=production
AIR_GAPPED_MODE=true

# Security & Authentication
SECRET_KEY=defence-grade-drishti-x-cryptographic-signing-key-32bytes-min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration (PostgreSQL supported, defaults to SQLite for local air-gapped demo)
DATABASE_URL=sqlite:///./drishti_x.db
# DATABASE_URL=postgresql://drishti:secure_defence_pass@localhost:5432/drishtix

# Storage paths
STORAGE_DIR=./data/uploads
MODELS_DIR=./models
DEMO_DATA_DIR=./data/demo

# CORS (Frontend access)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
